body{
    font-family: Arial, sans-serif;
    margin:0;
    background:#f4fff4;
}

header{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:20px;
}

main{
    padding:20px;
}

input{
    width:70%;
    padding:12px;
}

button{
    padding:12px;
    background:#2e8b57;
    color:white;
    border:none;
    cursor:pointer;
}

#resultado{
    margin-top:20px;
    padding:15px;
    background:white;
    border-radius:10px;
}

.galeria{
    margin-top:30px;
    display:flex;
    flex-wrap:wrap;
    gap:20px;
}

.erva{
    width:250px;
    background:white;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 0 10px rgba(0,0,0,.1);
}

.erva img{
    width:100%;
    height:180px;
    object-fit:cover;
}

.erva h3{
    text-align:center;
}

.aviso{
    margin-top:30px;
    color:red;
    font-weight:bold;
}
